generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ValveState {
  OPEN
  CLOSED
  UNKNOWN
}

enum ValveAction {
  OPEN
  CLOSE
  RESET_SAFETY
}

enum CommandStatus {
  PENDING
  APPLIED
  REJECTED
  FAILED
  EXPIRED
}

enum ReplacementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WeightStatus {
  LEGACY
  VALID
  UNCALIBRATED
  UNAVAILABLE
  INVALID
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model SystemState {
  id                  Int        @id @default(1)
  deviceId            String     @default("esp1")
  deviceOnline        Boolean    @default(false)
  esp2Online          Boolean    @default(false)
  lastSeenAt          DateTime?
  valveState          ValveState @default(UNKNOWN)
  leakActive          Boolean    @default(false)
  mq2Raw              Int?
  totalWeightKg       Float?
  gasKg               Float?
  gasPercentage       Float?
  weightStatus        WeightStatus @default(LEGACY)
  weightBootId        String?
  weightSampleSequence Int?
  weightMeasuredAt    DateTime?
  cylinderPresent     Boolean?
  updatedAt           DateTime   @updatedAt
  activeCylinderId    Int        @default(1)
  activeCylinder      GasCylinder @relation(fields: [activeCylinderId], references: [id])

  @@map("system_state")
}

model TelemetryReading {
  id                  BigInt     @id @default(autoincrement())
  deviceId            String
  receivedAt          DateTime   @default(now())
  totalWeightKg       Float?
  gasKg               Float?
  gasPercentage       Float?
  weightStatus        WeightStatus @default(LEGACY)
  weightBootId        String?
  weightSampleSequence Int?
  cylinderPresent     Boolean?
  mq2Raw              Int
  leakActive          Boolean
  valveState          ValveState
  esp2Online          Boolean
  cylinderId          Int      @default(1)
  cylinder           GasCylinder @relation(fields: [cylinderId], references: [id])

  @@index([receivedAt])
  @@map("telemetry_readings")
}

model LeakEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  acknowledgedAt      DateTime?
  peakMq2Raw          Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  cylinderId          Int       @default(1)
  cylinder           GasCylinder @relation(fields: [cylinderId], references: [id])
  commands            ValveCommand[]

  @@index([startedAt])
  @@map("leak_events")
}

model ValveCommand {
  id                  String        @id @default(uuid()) @db.Uuid
  action              ValveAction
  status              CommandStatus @default(PENDING)
  reason              String?
  requestedAt         DateTime      @default(now())
  completedAt         DateTime?
  reportedValveState  ValveState?
  leakEventId         String?       @db.Uuid
  leakEvent           LeakEvent?    @relation(fields: [leakEventId], references: [id])
  cylinderId          Int           @default(1)
  cylinder            GasCylinder   @relation(fields: [cylinderId], references: [id])

  @@index([requestedAt])
  @@index([status])
  @@map("valve_commands")
}

model GasCylinder {
  id                Int                @id @default(autoincrement())
  number            Int                @unique
  installedAt       DateTime           @default(now())
  removedAt         DateTime?
  initialWeightKg   Float?
  initialGasKg      Float?
  tareKg            Float              @default(0)
  capacityKg        Float              @default(13)
  finalWeightKg     Float?
  createdAt         DateTime           @default(now())
  state             SystemState[]
  telemetry         TelemetryReading[]
  leaks             LeakEvent[]
  commands          ValveCommand[]

  @@map("gas_cylinders")
}

model CylinderReplacement {
  id                 String            @id @default(uuid()) @db.Uuid
  status             ReplacementStatus @default(PENDING)
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  measuredWeightKg   Float?
  weightStable       Boolean           @default(false)
  lastReadingAt      DateTime?
  initialGasKg       Float?
  computedTareKg     Float?
  baselineBootId     String?
  baselineSampleSequence Int?
  measurementBootId String?
  measurementSampleSequence Int?

  @@index([status])
  @@map("cylinder_replacements")
}
