NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Copie as duas URLs em Connect > ORMs > Prisma no painel do Supabase.
# DATABASE_URL: pooler transacional (normalmente porta 6543), usado pela API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
# DIRECT_URL: conexão direta ou session pooler (normalmente porta 5432), usada nas migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
MQTT_URL=mqtt://localhost:1883
MQTT_DEVICE_ID=esp1
COMMAND_TIMEOUT_MS=5000
DEVICE_OFFLINE_AFTER_MS=90000
SAFETY_RESET_DELAY_MS=5000
JWT_SECRET=troque-esta-chave-por-uma-chave-com-pelo-menos-16-caracteres
PANEL_ALLOWED_EMAIL=safegas@gmail.com
CORS_ORIGIN=http://localhost:5173
